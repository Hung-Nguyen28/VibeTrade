{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibetrade.local/schema/v1.1/opportunity_queue.schema.json",
  "title": "VibeTrade v1.1 opportunity_queue.json",
  "description": "Deterministic surveillance anomaly opportunities queue for P3 Bar-Close gate and P4 research team. Strict bar-close confirmed, zero lookahead bias, plain decimal strings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc_ms",
    "market_regime",
    "queue_size",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "generated_at_utc_ms": { "type": "integer", "exclusiveMinimum": 0 },
    "market_regime": { "$ref": "#/$defs/market_regime" },
    "queue_size": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "inst_id": { "type": "string", "pattern": "^[A-Z0-9]+-USDT(-SWAP)?$" },
    "dec_pos": {
      "type": "string",
      "pattern": "^(?=[0-9.]*[1-9])[0-9]+(?:\\.[0-9]+)?$",
      "description": "Finite decimal string, plain notation, strictly > 0."
    },
    "dec_nonneg": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
      "description": "Finite decimal string, plain notation, >= 0."
    },
    "dec_signed": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
      "description": "Finite decimal string, plain notation, signed."
    },
    "epoch_ms": { "type": "integer", "exclusiveMinimum": 0 },
    "timeframe": {
      "enum": ["1m", "3m", "5m", "15m", "30m", "1H", "2H", "4H", "6H", "12H", "1D"]
    },
    "regime_enum": {
      "enum": ["BULL_TREND", "BEAR_TREND", "HIGH_VOL_CHOP", "RANGE_BOUND"]
    },
    "candidate_status": {
      "enum": ["PENDING", "IN_FOCUS", "EVALUATED", "EXPIRED"]
    },
    "market_regime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "multiplier",
        "btc_price",
        "btc_ema_fast",
        "btc_ema_slow",
        "btc_rsi",
        "btc_atr_pct",
        "market_breadth_pct",
        "detected_at_utc_ms",
        "details"
      ],
      "properties": {
        "regime": { "$ref": "#/$defs/regime_enum" },
        "multiplier": { "$ref": "#/$defs/dec_pos" },
        "btc_price": { "$ref": "#/$defs/dec_pos" },
        "btc_ema_fast": { "$ref": "#/$defs/dec_pos" },
        "btc_ema_slow": { "$ref": "#/$defs/dec_pos" },
        "btc_rsi": { "$ref": "#/$defs/dec_nonneg" },
        "btc_atr_pct": { "$ref": "#/$defs/dec_nonneg" },
        "market_breadth_pct": { "$ref": "#/$defs/dec_nonneg" },
        "detected_at_utc_ms": { "$ref": "#/$defs/epoch_ms" },
        "details": { "type": "object" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "inst_id",
        "timeframe",
        "candle_close_time",
        "status",
        "anomaly_types",
        "scanner_score",
        "metrics",
        "detected_at_utc_ms",
        "regime"
      ],
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-USDT(-SWAP)?:(1m|3m|5m|15m|30m|1H|2H|4H|6H|12H|1D):[0-9]+$"
        },
        "inst_id": { "$ref": "#/$defs/inst_id" },
        "timeframe": { "$ref": "#/$defs/timeframe" },
        "candle_close_time": { "$ref": "#/$defs/epoch_ms" },
        "status": { "$ref": "#/$defs/candidate_status" },
        "anomaly_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "scanner_score": { "$ref": "#/$defs/dec_nonneg" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "detected_at_utc_ms": { "$ref": "#/$defs/epoch_ms" },
        "regime": { "$ref": "#/$defs/regime_enum" }
      }
    }
  }
}
